---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import RoleCard from '../components/RoleCard.astro';
import EmptyState from '../components/EmptyState.astro';
import {
  getUniqueDepartments,
  getUniqueLocations,
  sortByNewest,
} from '../lib/jobs';
import type { Job } from '../types/job';

export const prerender = true;

const entries = await getCollection('jobs');
const jobs: Job[] = sortByNewest(
  entries.map((entry) => ({ slug: entry.id, ...entry.data })),
);
const departments = getUniqueDepartments(jobs);
const locations = getUniqueLocations(jobs);
---

<Layout title="Caldova Careers — Open roles">
  <div class="py-8">
    <section class="mb-10">
      <h1 class="text-4xl font-bold text-slate-100 mb-3">Build the future of medicine</h1>
      <p class="text-lg text-slate-400 max-w-2xl">
        Caldova is an AI-native pharmaceutical company. Explore our open roles
        and help us bring better treatments to patients faster.
      </p>
    </section>

    <h2 class="text-2xl font-medium mb-6 text-slate-100">Open roles</h2>

    {jobs.length === 0 ? (
      <EmptyState text="There are no open roles right now. Check back soon." />
    ) : (
      <>
        <div
          class="mb-6 grid grid-cols-1 sm:grid-cols-2 gap-4"
          data-testid="role-filters"
          data-jobs={JSON.stringify(jobs)}
        >
          <div>
            <label for="department-filter" class="block text-sm font-medium text-slate-300 mb-2">
              Department
            </label>
            <select
              id="department-filter"
              data-testid="department-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            >
              <option value="">All departments</option>
              {departments.map((department) => <option value={department}>{department}</option>)}
            </select>
          </div>
          <div>
            <label for="location-filter" class="block text-sm font-medium text-slate-300 mb-2">
              Location
            </label>
            <select
              id="location-filter"
              data-testid="location-filter"
              class="w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            >
              <option value="">All locations</option>
              {locations.map((location) => <option value={location}>{location}</option>)}
            </select>
          </div>
          <div class="sm:col-span-2">
            <button
              type="button"
              data-testid="role-filter-reset"
              class="rounded-lg border border-slate-600 px-4 py-2 text-slate-200 hover:border-blue-400 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-400"
            >
              Reset filters
            </button>
          </div>
        </div>

        <div
          hidden
          role="status"
          aria-live="polite"
          data-testid="role-filter-empty-state"
          class="mb-6"
        >
          <EmptyState text="No roles match these filters. Try changing your selections or reset the filters." />
        </div>

        <div
          class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6"
          data-testid="roles-grid"
        >
          {jobs.map((job) => <RoleCard job={job} />)}
        </div>
      </>
    )}
  </div>
</Layout>

<script>
  import { filterJobs } from '../lib/jobs';
  import type { Job } from '../types/job';

  const filters = document.querySelector<HTMLDivElement>('[data-testid="role-filters"]');
  const departmentFilter = document.querySelector<HTMLSelectElement>('#department-filter');
  const locationFilter = document.querySelector<HTMLSelectElement>('#location-filter');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-testid="role-filter-reset"]');
  const rolesGrid = document.querySelector<HTMLDivElement>('[data-testid="roles-grid"]');
  const emptyState = document.querySelector<HTMLDivElement>(
    '[data-testid="role-filter-empty-state"]',
  );

  if (filters && departmentFilter && locationFilter && resetButton && rolesGrid && emptyState) {
    const jobs: Job[] = JSON.parse(filters.dataset.jobs ?? '[]');
    const roleCards = Array.from(
      rolesGrid.querySelectorAll<HTMLAnchorElement>('[data-testid="role-card"]'),
    );

    /** Apply the selected filters to role cards and update the no-match message. */
    const applyFilters = (): void => {
      const matchingIds = new Set(
        filterJobs(jobs, departmentFilter.value, locationFilter.value).map((job) => job.slug),
      );

      for (const card of roleCards) {
        card.hidden = !matchingIds.has(card.dataset.jobId ?? '');
      }

      emptyState.hidden = matchingIds.size > 0;
    };

    departmentFilter.addEventListener('change', applyFilters);
    locationFilter.addEventListener('change', applyFilters);
    resetButton.addEventListener('click', () => {
      departmentFilter.value = '';
      locationFilter.value = '';
      applyFilters();
    });
  }
</script>
